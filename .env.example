# Copy to .env and fill in from Supabase → Project Settings → API.
# Project URL only (no /rest/v1). Use the anon / publishable key, never the service_role / secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: "true" shows the "Under maintenance" page on the public site
# (the CTF portal keeps working). Redeploy after changing.
# VITE_MAINTENANCE=true
